require "shellfish/ui";
require "./mediabookmark.js" as mediabookmark;

MouseBox {
    id: item

    property highlighted: false
    property file: null
    property fs: null
    property thumbnail: ""
    property background: ""

    color: containsMouse ? theme.secondaryColor : "transparent"
    layout: "row"

    event openFile

    function stripExtension(filename)
    {
        const pos = filename.lastIndexOf(".");
        if (pos !== -1)
        {
            return filename.substr(0, pos);
        }
        else
        {
            return pos;
        }
    }

    function makeRoleLabel(file, role)
    {
        if (! file)
        {
            return "-";
        }

        if (role === "name")
        {
            if (file.type === "d")
            {
                return escapeMarkup(file.name);
            }
            else
            {
                const parts = file.name.split(".");
                let ext = "";
                if (parts.length > 1)
                {
                    ext = parts.pop();
                }
                return escapeMarkup(parts.join("."));
            }
        }
        else if (role === "mtime")
        {
            return new Date(file.mtime * 1000).toISOString().split("T")[0];
        }
        else if (role === "size")
        {
            if (file.type === "d")
            {
                return "";
            }
            else
            {
                return core.formatBytes(file.size);
            }
        }
        else if (role === "type")
        {
            if (file.type === "d")
            {
                return "Folder";
            }
            else
            {
                const parts = file.name.split(".");
                let ext = "";
                if (parts.length > 1)
                {
                    ext = parts.pop();
                }
                return ext !== "" ? ext : file.mimetype;
            }
        }

        return "-";
    }

    onFileChanged: () =>
    {
        priv.mediaBookmark = null;
        contentsModel.reset([]);

        if (fs && file && file.type === "d")
        {
            const forPath = file.path;

            const f = async () =>
            {
                const files = await fs.list(file.path);
                if (file.path !== forPath)
                {
                    return;
                }

                const bookmark = await mediabookmark.read(fs, file.path);
                if (file.path !== forPath)
                {
                    return;
                }

                const medias = files.filter(f => f.mimetype.startsWith("video/") ||
                                                 f.mimetype.startsWith("audio/"));
                priv.mediaBookmark = bookmark;
                contentsModel.reset(medias);

                if (bookmark)
                {
                    const idx = medias.findIndex(a => a.path === bookmark.path);
                    if (idx !== -1)
                    {
                        await wait(500);
                        if (file.path !== forPath)
                        {
                            return;
                        }

                        listView.positionViewAt(idx);
                    }
                }
            };
            f();
        }
    }
 
    Object {
        id: priv

        property mediaBookmark: null
    }

    ListModel {
        id: contentsModel
    }

    onClick: ev =>
    {
        ev.accepted = true;

        if (contentsModel.size === 0)
        {
            openFile(file, 0);
        }
        else if (contentsModel.size === 1)
        {
            openFile(contentsModel.at(0), 0);
        }
        else
        {
            const idx = Math.round(listView.contentX / listView.cellWidth);
            openFile(contentsModel.at(idx), 0);
        }
    }

    // image box
    Box {
        margins: 2
        width: bboxHeight //* 16/9
        fillHeight: true
        color: theme.primaryBackgroundColor

        Image {
            id: backdrop

            visible: status === "success"
            fill: true
            source: item.background !== "" ? item.background
                                           : item.thumbnail !== "" ? item.thumbnail
                                                                   : ""
            fitMode: "cover"
        }

        Box {
            visible: ! item.containsMouse
            position: "free"
            fill: true
            color: parent.color.alpha(0.6)
        }
    }

    Button {
        visible: contentsModel.size > 1
        width: theme.itemWidthMedium
        fillHeight: true
        flat: true
        repeatAcceleration: 1.0
        icon: "ui-arrow_left"

        onClick: ev =>
        {
            ev.accepted = true;
            listView.contentX -= listView.cellWidth;
        }
    }

    Box {
        fill: true
        layout: "center"

        // label box
        Label {
            id: label

            margins: theme.paddingSmall
            fillWidth: true
            horizontalAlignment: "center"
            overflowBehavior: "wrap"
            bold: true
            fontSize: theme.fontSizeMedium * 1.5
            color: item.containsMouse ? theme.primaryBackgroundColor
                                        : theme.primaryColor

            text: makeRoleLabel(item.file, "name")
        }

        // contents box
        Box {
            visible: contentsModel.size > 1
            position: "free"
            origin: "bottom-left"
            fillWidth: true
            height: theme.itemHeightMedium

            layout: "center-column"

            Box {
                layout: "row"
                marginBottom: theme.paddingSmall

                Repeater {
                    model: contentsModel.size < 42 ? contentsModel.size : 0
                    delegate: template Box {
                        margins: 2
                        width: height
                        height: theme.fontSizeSmall
                        borderRadius: width / 2
                        borderWidth: 1
                        borderColor: item.containsMouse ? theme.primaryBackgroundColor
                                                        : theme.primaryColor
                        color: modelData.index === Math.round(listView.contentX / listView.cellWidth) ? borderColor : "transparent"
                    }
                }
            }

            ListView {
                id: listView

                fill: true
                model: contentsModel
                orientation: "horizontal"
                snapMode: "begin"
                cellWidth: bboxWidth
                cellHeight: bboxHeight

                contentXTransition: NumberAnimation { }

                delegate: template Box {
                    layout: "center-row"

                    Label {
                        property hasBookmark: priv.mediaBookmark?.path === modelData.value.path
                        property formattedTime: hasBookmark ? core.formatSeconds(priv.mediaBookmark.mediaPosition, false) : ""

                        marginLeft: theme.paddingSmall
                        marginRight: theme.paddingLarge
                        fillWidth: true
                        color: item.containsMouse ? theme.primaryBackgroundColor
                                                  : theme.primaryColor
                        horizontalAlignment: "center"
                        overflowBehavior: "ellipsis"

                        text: (modelData.index + 1) + " / " + contentsModel.size + ": " +
                              escapeMarkup(stripExtension(modelData.value.name)) +
                              (hasBookmark ? " ([icon:media-play] " + formattedTime + ")" : "")
                    }
                }
            }
        }
    }

    Button {
        visible: contentsModel.size > 1
        width: theme.itemWidthMedium
        fillHeight: true
        flat: true
        repeatAcceleration: 1.0
        icon: "ui-arrow_right"

        onClick: ev =>
        {
            ev.accepted = true;
            listView.contentX += listView.cellWidth;
        }
    }

    Button {
        width: theme.itemWidthMedium
        fillHeight: true
        flat: true

        FSIcon {
            id: fileIcon
            visible: false
            mimeType: item.file?.mimetype
        }

        text: fileIcon.text

        onClick: ev =>
        {
            ev.accepted = true;
            item.openFile(item.file, 0);
        }
    }

}